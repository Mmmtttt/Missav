{
  "protocol_version": "1.0",
  "plugin": {
    "id": "video.missav",
    "name": "Missav",
    "version": "1.0.0",
    "entrypoint": "./ultimate_provider.py:MissavProvider"
  },
  "media_types": ["video"],
  "identity": {
    "content_type": "video",
    "platform_label": "MISSAV",
    "aliases": ["missav"]
  },
  "capabilities": [
    { "key": "playback.sources.build" },
    { "key": "playback.proxy.stream" },
    { "key": "playback.proxy.url" },
    { "key": "transport.http.request" }
  ],
  "configuration": {
    "order": 100,
    "label": "Missav",
    "credential": {
      "enabled_field": "enabled",
      "required_fields": [],
      "unconfigured_message": "",
      "disabled_message": "MissAV 平台未启用，不能使用该平台查询。"
    },
    "sections": [
      {
        "key": "basic",
        "label": "基础配置",
        "fields": [
          { "key": "enabled", "label": "启用", "type": "boolean" },
          { "key": "impersonate", "label": "浏览器指纹", "type": "text", "placeholder": "chrome131" },
          { "key": "domains", "label": "候选域名", "type": "textarea", "placeholder": "missav.ai,missav.ws,missav.com" },
          { "key": "cookie_string", "label": "Cookie", "type": "textarea", "placeholder": "可留空", "secret": true }
        ]
      }
    ]
  },
  "runtime": {
    "python_paths": ["."],
    "vendor_path_templates": [
      "vendor/python",
      "vendor/python/{python_tag}",
      "vendor/python/{python_tag}/{platform_tag}"
    ]
  },
  "resource_policy": {
    "assets": {
      "video": {
        "request_profiles": [
          {
            "match_hosts": ["missav.ai", "surrit.com", "mushroomtrack.com"],
            "referer": "https://missav.ai/",
            "origin": "https://missav.ai",
            "frontend_proxy": true
          }
        ]
      },
      "preview_video": {
        "available": true,
        "download_enabled": false,
        "request_profiles": [
          {
            "match_hosts": ["missav.ai", "surrit.com", "mushroomtrack.com"],
            "referer": "https://missav.ai/",
            "origin": "https://missav.ai",
            "frontend_proxy": true
          }
        ]
      }
    }
  },
  "packaging": {
    "external": {
      "pip_requirements": ["curl_cffi>=0.6.0", "cffi>=1.15.0", "playwright>=1.55.0"]
    },
    "pyinstaller": {
      "collect_all": ["curl_cffi", "cffi", "playwright"],
      "pip_requirements": ["curl_cffi>=0.6.0", "cffi>=1.15.0", "playwright>=1.55.0"]
    }
  }
}
